{
    "name": "andydefer/inverted-index-search",
    "description": "A powerful search engine library based on Inverted Index for PHP - Full-text search, boolean queries, and expression evaluation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Kani",
            "email": "andykanidimbu@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "andydefer/algo-kit": "^0.8.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.29",
        "symfony/var-dumper": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "AndyDefer\\InvertedIndexSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndyDefer\\InvertedIndexSearch\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
